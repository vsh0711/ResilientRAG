# Where the browser sends API calls.
#
# Vercel deployment: the public URL of the backend (Hugging Face Space, VPS, ...).
# The backend must list your Vercel origin in API_CORS_ORIGINS.
# NEXT_PUBLIC_API_URL=https://your-space.hf.space
#
# Leave it unset for local dev and Docker: requests go through the same-origin
# /api/proxy route, which forwards to API_PROXY_TARGET.
# API_PROXY_TARGET=http://localhost:8000
