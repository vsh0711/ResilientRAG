# Required: get a free-tier key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown) — see backend/app/config.py for the full list
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_MODEL=qwen/qwen3.8-27b

QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
# Download embedding models when the API process starts.
WARMUP_MODELS=false
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Per browser session (X-Session-Id). The IP ceiling only stops session-id spraying.
RATE_LIMIT_PER_MINUTE=60
IP_RATE_LIMIT_PER_MINUTE=1200
QUERY_TIMEOUT_SECONDS=180
MAX_CONCURRENT_QUERIES=12
MAX_CONCURRENT_UPLOADS=2

SCORE_PASS_THRESHOLD=0.8
MAX_RETRIES_DEFAULT=3

# Frontend dev server proxies /api/proxy to this process. In Docker the
# compose file sets API_PROXY_TARGET=http://backend:8000 instead.
# API_PROXY_TARGET=http://localhost:8000

# --- Deployment (docker-compose.prod.yml) ---
# Public hostname Caddy gets a certificate for.
# DOMAIN=rag.example.com
# Comma-separated access codes people must enter. Required in production.
# Generate one with:  openssl rand -base64 18
# ACCESS_CODES=
